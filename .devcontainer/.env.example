# =============================================================================
# Burnout-as-a-Service — devcontainer environment template
# =============================================================================
# Copy this file to `.env` at the repo root (the post-create script does this
# automatically on first build). Fill in the Azure OpenAI values to enable the
# real LLM-powered reshape agent. Leave them as the dummy values to use the
# deterministic fallback (the demo still works end-to-end).
# =============================================================================

# --- Backend security (keep false for the demo so /api/** doesn't need a token)
SECURITY_ENABLED=false

# --- Azure OpenAI (optional — dummy values trigger deterministic fallback)
AZURE_OPENAI_ENDPOINT=https://dummy.openai.azure.com
AZURE_OPENAI_API_KEY=dummy-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Backend URL used by the MCP app (only needed if you run mcp-app)
BACKEND_URL=http://localhost:8080
